# Baghewala Digital Twin Configuration
PROJECT_NAME="Baghewala CSS-SRP Digital Twin"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baghewala_db"
TEST_DATABASE_URL="sqlite:///:memory:"

# Security & Safety
ENFORCE_STRICT_SAFETY=true
REQUIRE_HUMAN_APPROVAL=true

# Physics Engine Defaults
DEFAULT_CANONICAL_UNITS="SI"

# Optional MLflow Integration
ENABLE_MLFLOW=false
MLFLOW_TRACKING_URI="http://localhost:5000"
