{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReservoirProperties",
  "type": "object",
  "properties": {
    "well_id": { "type": "string" },
    "initial_pressure_kpa": { "type": "number", "minimum": 0 },
    "initial_temperature_c": { "type": "number" },
    "porosity": { "type": "number", "minimum": 0, "maximum": 1 },
    "permeability_md": { "type": "number", "minimum": 0 },
    "pay_thickness_m": { "type": "number", "minimum": 0 },
    "drainage_radius_m": { "type": "number", "minimum": 0 },
    "wellbore_radius_m": { "type": "number", "minimum": 0 },
    "rock_heat_capacity_j_kg_k": { "type": "number", "minimum": 0 },
    "rock_density_kg_m3": { "type": "number", "minimum": 0 }
  },
  "required": ["well_id", "initial_pressure_kpa", "initial_temperature_c", "pay_thickness_m"]
}
