{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductionTimeSeries",
  "type": "object",
  "properties": {
    "well_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "oil_rate_m3d": { "type": "number", "minimum": 0 },
    "water_rate_m3d": { "type": "number", "minimum": 0 },
    "gas_rate_m3d": { "type": "number", "minimum": 0 },
    "wellhead_temperature_c": { "type": "number" },
    "wellhead_pressure_kpa": { "type": "number", "minimum": 0 }
  },
  "required": ["well_id", "timestamp", "oil_rate_m3d", "water_rate_m3d"]
}
