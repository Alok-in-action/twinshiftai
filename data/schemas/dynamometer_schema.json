{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DynamometerCardData",
  "type": "object",
  "properties": {
    "well_id": { "type": "string" },
    "card_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "card_type": { "type": "string", "enum": ["surface", "downhole"] },
    "stroke_length_in": { "type": "number", "minimum": 0 },
    "spm": { "type": "number", "minimum": 0 },
    "position_in": {
      "type": "array",
      "items": { "type": "number" }
    },
    "load_lbs": {
      "type": "array",
      "items": { "type": "number" }
    },
    "num_samples": { "type": "integer", "minimum": 2 }
  },
  "required": ["well_id", "timestamp", "card_type", "position_in", "load_lbs", "num_samples"]
}
