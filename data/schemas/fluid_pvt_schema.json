{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FluidPVTProperties",
  "type": "object",
  "properties": {
    "well_id": { "type": "string" },
    "oil_api_gravity": { "type": "number" },
    "water_specific_gravity": { "type": "number" },
    "gas_specific_gravity": { "type": "number" },
    "andrade_coeff_a": { "type": ["number", "null"] },
    "andrade_coeff_b": { "type": ["number", "null"] },
    "viscosity_table": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "temperature_c": { "type": "number" },
          "viscosity_cp": { "type": "number", "minimum": 0 }
        },
        "required": ["temperature_c", "viscosity_cp"]
      }
    }
  },
  "required": ["well_id", "oil_api_gravity", "viscosity_table"]
}
